{
  "name": "@teampulse/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Principal, authorization helpers, and access-token verification against a JWKS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jwt": {
      "types": "./dist/jwt.d.ts",
      "default": "./dist/jwt.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@teampulse/contracts": "0.1.0",
    "@teampulse/kernel": "0.1.0",
    "jose": "^6.2.18"
  }
}

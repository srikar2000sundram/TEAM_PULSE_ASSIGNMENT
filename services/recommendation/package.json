    "@teampulse/db": "0.1.0",
    "@teampulse/http": "0.1.0",
    "@teampulse/inbox": "0.1.0",
    "@teampulse/kernel": "0.1.0",
    "@teampulse/observability": "0.1.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@teampulse/testing": "0.1.0",
    "jose": "^6.2.18"

{
  "name": "teampulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TeamPulse: an internal wellness and consistency platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "lambdas/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync": "npm run sync --workspace @teampulse/web",
    "build": "tsc -b",
    "typecheck": "npm run build && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "docs:check": "node tools/check-mermaid.mjs",
    "test": "vitest run --project unit && vitest run --project frontend && vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run sync && npm run build && npm run lint && npm run typecheck && npm test && npm run docs:check",
    "local:env": "node tools/local/make-env.mjs",
    "local:up": "node tools/local/compose.mjs up",
    "local:down": "node tools/local/compose.mjs down",
    "local:reset": "node tools/local/compose.mjs reset",
    "local:smoke": "node tools/local/smoke.mjs",
    "load": "node tools/load/load-test.mjs",
    "load:burst": "node tools/load/load-test.mjs --burst",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "bundle:lambdas": "node tools/lambda/bundle.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "jsdom": "^25.0.1",
    "mermaid": "^11.4.0",
    "prettier": "^3.3.3",
    "rolldown": "^1.2.19",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
